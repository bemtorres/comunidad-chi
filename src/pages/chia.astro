---
import Habla from "../components/HablaModal.astro";
import SEO from "../components/SEO.astro";
const base = import.meta.env.BASE_URL;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "LearningResource",
    name: "CHIA · Nivel 1 para aprender chi gratis",
    description:
      "Lecciones del nivel CHIA: historia, sílabas chi, chiis y chion, 10 frases, cuento corto y mini-diálogo para presentarte en chi.",
    url: "https://www.chihochila.com/chia/",
    inLanguage: "es",
    learningResourceType: "Curso",
    isAccessibleForFree: true,
    educationalLevel: "Principiante",
    provider: { "@type": "Organization", name: "Comunidad Chi", url: "https://www.chihochila.com/" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: "https://www.chihochila.com/" },
      { "@type": "ListItem", position: 2, name: "Curso chi gratis", item: "https://www.chihochila.com/curso/" },
      { "@type": "ListItem", position: 3, name: "CHIA", item: "https://www.chihochila.com/chia/" },
    ],
  },
];
---
<!DOCTYPE html>
<html lang="es">
<head>
<SEO
  title="CHIA Nivel 1 · Aprende chi gratis | chihochila.com"
  description="Nivel 1 del curso de chi gratis: historia, sílabas chi, chiis y chion, 10 frases, cuento y diálogo para presentarte en chi (chihochila) desde cero."
  path="/chia/"
  keywords="curso chi nivel 1, aprender chi gratis, CHIA chi, chiis chion, aprender chihochila, chi para principiantes"
  jsonLd={jsonLd}
/>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&family=Outfit:wght@300;400;600;700;800&family=Noto+Serif+SC:wght@600;900&display=swap" rel="stylesheet" />
<style>
:root{--rojo:#a31616;--rojo-b:#c1272d;--dorado:#d4af37;--dorado-c:#f9e076;--crema:#fff8e7;--papel:#fdf3d8;--tinta:#2b1510;--negro:#160808;--verde:#2e7d32}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;font-family:'Outfit',system-ui,sans-serif;background:var(--negro);color:var(--crema)}
.pattern-bg{position:fixed;inset:0;z-index:-2;background:radial-gradient(circle at 20% 20%,#1c5c2a 0%,transparent 45%),linear-gradient(180deg,#0d1f10,#162b16 50%,#0a120a)}
.pattern-bg::after{content:"";position:absolute;inset:0;opacity:.08;background-image:repeating-linear-gradient(45deg,var(--dorado) 0 2px,transparent 2px 28px),repeating-linear-gradient(-45deg,var(--dorado) 0 2px,transparent 2px 28px)}
nav{position:sticky;top:0;z-index:60;backdrop-filter:blur(12px);background:rgba(10,18,10,.92);border-bottom:2px solid var(--dorado)}
.nav-inner{max-width:1100px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;padding:.7rem 1.2rem;gap:.6rem}
.logo{display:flex;align-items:center;gap:.6rem;font-weight:800}
.sello{width:42px;height:42px;background:var(--verde);display:grid;place-items:center;border-radius:8px;font-family:'Ma Shan Zheng',serif;font-size:1.7rem;border:2px solid var(--dorado)}
.nav-links{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap;font-size:.88rem}
.nav-links a{color:inherit;text-decoration:none;opacity:.9}
#btn-lang{position:sticky;background:var(--dorado);color:#2b1510;border:none;border-radius:999px;padding:.55rem 1.1rem;font-weight:800;cursor:pointer;font-family:inherit;box-shadow:0 4px 14px rgba(0,0,0,.4)}
#btn-lang:hover{background:var(--dorado-c)}
.wrap{max-width:1000px;margin:0 auto;padding:0 1.2rem}
.hero{text-align:center;padding:3rem 0 1rem}
h1{font-family:'Ma Shan Zheng',serif;font-size:clamp(2.8rem,7vw,4.8rem);margin:.4rem 0}
h1 span{color:var(--dorado-c)}
h2{font-family:'Ma Shan Zheng',serif;font-size:clamp(1.8rem,4vw,2.6rem);margin:0;font-weight:400}
h2 em{color:var(--dorado-c);font-style:normal}
.etiqueta{display:inline-block;border:1px solid var(--dorado);border-radius:999px;padding:.35rem .9rem;font-size:.8rem;letter-spacing:.16em;color:var(--dorado-c);background:rgba(212,175,55,.12)}
.instr{background:#fff8e7;color:#2b1510;border-radius:14px;padding:.9rem 1.1rem;border:3px solid var(--dorado);margin:1rem 0;line-height:1.6}
section{padding:1.8rem 0}
.linea{height:2px;background:linear-gradient(90deg,transparent,var(--dorado),transparent);margin:1rem 0 1.4rem}
.card{background:rgba(255,248,231,.07);border:1px solid rgba(212,175,55,.4);border-radius:18px;padding:1.2rem;margin:.8rem 0}
.card.papel{background:linear-gradient(180deg,var(--papel),#f6e6b3);color:var(--tinta);border:3px solid var(--dorado)}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
@media(max-width:800px){.grid2{grid-template-columns:1fr}.nav-links a.hidem{display:none}}
.frase{background:#fffdf2;color:var(--tinta);border-radius:14px;padding:.9rem;border-left:8px solid var(--verde);margin:.6rem 0}
.frase .t{font-family:'Ma Shan Zheng',serif;font-size:1.45rem;color:var(--rojo)}
.frase .ayuda{font-size:.85rem;opacity:.75}
.tabla{width:100%;border-collapse:collapse;background:#fffdf2;color:var(--tinta);border-radius:12px;overflow:hidden;font-size:.95rem}
.tabla th{background:var(--verde);color:#fff;padding:.6rem;text-align:left}
.tabla td{padding:.6rem;border-bottom:1px solid #d8c98f}
.chiout{font-weight:800;color:var(--rojo)}
.cuento{background:linear-gradient(180deg,#fffdf2,#f7e7b8);color:var(--tinta);border-radius:18px;padding:1.3rem;border:4px double var(--verde);line-height:1.9;font-size:1.1rem}
.cuento .t{display:block;margin:.4rem 0}
.chat{display:flex;flex-direction:column;gap:.6rem;margin-top:.8rem}
.bubble{max-width:85%;padding:.7rem 1rem;border-radius:16px;line-height:1.5}
.bubble.left{background:#eaffea;color:#123d1f;align-self:flex-start;border:2px solid var(--verde)}
.bubble.right{background:#fff;color:#5c0a0a;align-self:flex-end;border:2px solid var(--dorado)}
.bubble b{font-size:.78rem;display:block;opacity:.7}
.bubble .t{font-weight:700;font-size:1.1rem}
button.say{margin-top:.35rem;font-size:.82rem;border-radius:999px;border:1px solid currentColor;background:transparent;padding:.25rem .7rem;cursor:pointer}
.examen{background:rgba(46,125,50,.18);border:2px dashed var(--dorado);border-radius:16px;padding:1.1rem;margin-top:.8rem}
footer{border-top:2px solid var(--dorado);padding:1.6rem;text-align:center;opacity:.85}
.btn{display:inline-block;border:none;border-radius:999px;padding:.75rem 1.3rem;font-weight:800;text-decoration:none;font-family:inherit;cursor:pointer}
.btn-d{background:var(--dorado);color:#2b1510}.btn-g{background:transparent;color:var(--crema);border:1px solid var(--dorado)}
.modo-aviso{font-size:.85rem;opacity:.85}
</style>
</head>
<body>
<div class="pattern-bg"></div>
<nav><div class="nav-inner">
<div class="logo"><div class="sello">芽</div><a href={`${base}curso/`} style="text-decoration:none;color:inherit">← Curso</a><span>· CHIA 🌱</span></div>
<div class="nav-links"><a class="hidem" href={base}>🏠</a><a class="hidem" href={`${base}chib/`}>CHIB 🔥</a><a href={`${base}chic/`}>CHIC 🐲</a><button id="btn-lang">👁 Ver en ES</button></div>
</div></nav>
<div class="wrap">
<header class="hero">
<div class="etiqueta">🌱 NIVEL 1 · 初级 · EL DESPERTAR 初醒</div>
<h1>CHIA <span>气A</span></h1>
<p class="modo-aviso">Todo está escrito en <strong>Chi</strong>. Usa el botón <strong>👁 Ver en ES</strong> de arriba para ver las instrucciones en español.</p>
<div class="instr"><strong class="t" data-es="Instrucción: todo lo que ves está en Chi. Toca 👁 Ver en ES si te pierdes. Escucha 🔊 cada frase y repítela con reverencia 🙏.">Instrucción</strong><br/><span class="t" data-es="Meta de CHIA: saludar, presentarte y responder sí (chiis) o no (chion) con expresión.">Meta</span></div>
</header>

<section>
<h2>📜 Historia <em>历史 — el secreto de los abuelos</em></h2>
<div class="linea"></div>
<div class="card papel">
<p class="t" data-es="Hace mucho, los abuelos querían hablar sin que los niños entendieran. Inventaron poner chi antes de cada sílaba. Hola se volvió chihochila. Era su código secreto.">historia1</p>
<p class="t" data-es="Cuando los niños crecían, los abuelos les enseñaban el secreto con una reverencia. Si decías sí, decías chiis con sonrisa. Si decías no, decías chion con cara seria. Así nació CHIA, el primer paso.">historia2</p>
<button class="say btn btn-d">🔊 Escuchar historia</button>
</div>
</section>

<section>
<h2>🔤 Lección 1 <em>la regla + chiis y chion</em></h2>
<div class="linea"></div>
<div class="grid2">
<div class="card"><h3>✦ Regla: chi + cada sílaba</h3><p class="t" data-es="Separa en sílabas y pon chi delante. Ejemplo: hola es ho-la, entonces chiho-chila.">regla</p>
<table class="tabla"><tr><th>ES</th><th>CHI</th></tr>
<tr><td>hola</td><td class="chiout" data-src="hola"></td></tr>
<tr><td>casa</td><td class="chiout" data-src="casa"></td></tr>
<tr><td>mamá</td><td class="chiout" data-src="mamá"></td></tr>
<tr><td>papá</td><td class="chiout" data-src="papá"></td></tr>
<tr><td>gracias</td><td class="chiout" data-src="gracias"></td></tr>
<tr><td>amigo</td><td class="chiout" data-src="amigo"></td></tr>
</table></div>
<div class="card"><h3>✅ Las sagradas</h3><p class="t" data-es="Sí no es chisi, es chiis alargado hacia arriba. No no es chino, es chion cortante hacia abajo.">sagradas</p>
<table class="tabla"><tr><th>ES</th><th>CHI sagrado</th><th>Cómo</th></tr>
<tr><td>sí</td><td class="chiout" data-src="sí"></td><td>🙏 ¡chiiiiis! ⬆</td></tr>
<tr><td>no</td><td class="chiout" data-src="no"></td><td>👊 ¡chion! ⬇</td></tr>
</table>
<p class="t" data-es="Repite 5 veces: chiis con sonrisa, chion con brazos cruzados.">repite</p></div>
</div>
</section>

<section>
<h2>💬 Frases <em>frases de CHIA</em></h2>
<div class="linea"></div>
<div id="frases">
<div class="frase"><div class="t" data-es="Hola, ¿cómo estás?">f</div><div class="ayuda">🙏 reverencia + sonrisa · saludo</div><button class="say">🔊</button></div>
<div class="frase"><div class="t" data-es="Me llamo Dragón">f</div><div class="ayuda">❤️ mano al pecho · presentarse</div><button class="say">🔊</button></div>
<div class="frase"><div class="t" data-es="Mucho gusto">f</div><div class="ayuda">🙏 reverencia corta</div><button class="say">🔊</button></div>
<div class="frase"><div class="t" data-es="Gracias">f</div><div class="ayuda">🙏 reverencia profunda</div><button class="say">🔊</button></div>
<div class="frase"><div class="t" data-es="Por favor">f</div><div class="ayuda">🙏 manitas juntas</div><button class="say">🔊</button></div>
<div class="frase"><div class="t" data-es="Sí, con alegría">f</div><div class="ayuda">🙏 ¡chiis! ⬆ sonrisa grande</div><button class="say">🔊</button></div>
<div class="frase"><div class="t" data-es="No, gracias">f</div><div class="ayuda">👊 ¡chion! ⬇ + reverencia</div><button class="say">🔊</button></div>
<div class="frase"><div class="t" data-es="Adiós, nos vemos">f</div><div class="ayuda">👋 dos manos + cantado</div><button class="say">🔊</button></div>
</div>
</section>

<section>
<h2>📖 Cuento <em>el pequeño dragón Chiho</em></h2>
<div class="linea"></div>
<div class="cuento">
<span class="t" data-es="Había un pequeño dragón que no sabía hablar. Solo decía ho.">c1</span>
<span class="t" data-es="Su abuela le enseñó el secreto: pon chi antes de todo. Ho se volvió chiho.">c2</span>
<span class="t" data-es="El dragón dijo chihochila y todos sonrieron. Dijo chiis con alegría.">c3</span>
<span class="t" data-es="Desde ese día, el dragón saluda en Chi. Fin.">c4</span>
<div><button class="say btn btn-d">🔊 Escuchar cuento</button></div>
</div>
</section>

<section>
<h2>👋 Diálogo <em>saludar a otro</em></h2>
<div class="linea"></div>
<div class="card"><p class="t" data-es="Lee con un compañero. Uno es A, otro es B. Con reverencia y sonrisa.">instr dialogo</p>
<div class="chat">
<div class="bubble left"><b>🐼 A</b><div class="t" data-es="Hola, ¿cómo estás?">d</div><button class="say">🔊</button></div>
<div class="bubble right"><b>🐯 B</b><div class="t" data-es="Hola, estoy feliz. ¿Y tú?">d</div><button class="say">🔊</button></div>
<div class="bubble left"><b>🐼 A</b><div class="t" data-es="Me llamo Dragón. Mucho gusto.">d</div><button class="say">🔊</button></div>
<div class="bubble right"><b>🐯 B</b><div class="t" data-es="Sí, qué alegría verte. Adiós.">d</div><button class="say">🔊</button></div>
</div>
<div class="examen"><strong class="t" data-es="Examen CHIA: saluda en Chi, di tu nombre y responde chiis o chion sin mirar. Si lo haces con expresión, pasas a CHIB.">examen</strong><br/><br/><a class="btn btn-d" href={`${base}chib/`}>Pasar a CHIB 🔥 →</a> <a class="btn btn-g" href={`${base}curso/`}>← Curso</a></div>
</div>
</section>
</div>
<footer>🌱 CHIA · Hola = chihochila · Sí = chiis [chīís] · No = chion [chiǒn] · <a href={`${base}curso/`} style="color:inherit">Curso</a></footer>
<script>
const VOC="aeiouáéíóúüAEIOUÁÉÍÓÚÜ";const esV=c=>VOC.includes(c);const esF=c=>"áéíóúÁÉÍÓÚ".includes(c);
function dividirSilabas(p){if(!p)return[];const w=p,n=w.length;let idx=[];for(let i=0;i<n;i++)if(esV(w[i]))idx.push(i);if(idx.length===0)return[w];if(idx.length===1)return[w];let cortes=[];for(let k=0;k<idx.length-1;k++){const v1=idx[k],v2=idx[k+1],entre=w.slice(v1+1,v2),c=entre.length;if(c===0){const a=w[v1].toLowerCase(),b=w[v2].toLowerCase(),deb=new Set(['i','u','ü']);const dip=(deb.has(a)||deb.has(b))&&!esF(w[v1])&&!esF(w[v2]);if(!dip)cortes.push(v2);}else if(c===1)cortes.push(v1+1);else if(c===2){const cc=entre.toLowerCase(),g=['br','cr','dr','fr','gr','pr','tr','bl','cl','dl','fl','gl','pl','tl','ch','ll','rr','qu','gu'];cortes.push(g.includes(cc)?v1+1:v1+2);}else if(c===3){const u2=entre.slice(1).toLowerCase(),g=['br','cr','dr','fr','gr','pr','tr','bl','cl','fl','gl','pl','tr'];cortes.push(g.includes(u2)?v1+2:v1+3);}else cortes.push(v1+c-1);}let s=[],ini=0;for(const co of cortes){if(co>0&&co<n){s.push(w.slice(ini,co));ini=co;}}s.push(w.slice(ini));return s.filter(Boolean);}
function copiarMayus(o,d){if(!o)return d;return o[0]===o[0].toUpperCase()?d[0].toUpperCase()+d.slice(1):d;}
function palabraAChi(pal){const m=pal.match(/^([^A-Za-zÁÉÍÓÚÜÑñáéíóúü]*)([A-Za-zÁÉÍÓÚÜÑñáéíóúü]+)([^A-Za-zÁÉÍÓÚÜÑñáéíóúü]*)$/);if(!m)return pal;const[,pre,nuc,post]=m,low=nuc.toLowerCase();if(low==="sí"||low==="si")return pre+copiarMayus(nuc,"chiis")+post;if(low==="no")return pre+copiarMayus(nuc,"chion")+post;return pre+copiarMayus(nuc,dividirSilabas(nuc).map(s=>"chi"+s.toLowerCase()).join(""))+post;}
function espanolAChi(t){return t.split(/(\s+)/).map(ch=>/^\s+$/.test(ch)?ch:ch.split(/([A-Za-zÁÉÍÓÚÜÑñáéíóúü]+)/g).map(p=>/^[A-Za-zÁÉÍÓÚÜÑñáéíóúü]+$/.test(p)?palabraAChi(p):p).join("")).join("");}
let modo='chi';const btn=document.getElementById('btn-lang');
function aplicar(){document.querySelectorAll('[data-es]').forEach(el=>{const es=el.getAttribute('data-es');el.textContent=modo==='chi'?espanolAChi(es):es;});document.querySelectorAll('.chiout').forEach(el=>{el.textContent=espanolAChi(el.getAttribute('data-src')||'');});btn.textContent=modo==='chi'?'👁 Ver en ES':'🐉 Ver en CHI';}
btn.addEventListener('click',()=>{modo=modo==='chi'?'es':'chi';aplicar();});
function escuchar(tx){if(window.hablar)window.hablar(tx);}
document.querySelectorAll('button.say').forEach(b=>b.addEventListener('click',()=>{const c=b.closest('.frase,.cuento,.card,.bubble,div');let t=c?c.querySelector('.t,.chiout'):null;let txt=t?t.textContent:b.textContent;if(b.closest('.cuento')&&c.classList.contains('cuento')){txt=[...c.querySelectorAll('.t')].map(x=>x.textContent).join(' ');}escuchar(txt);}));
aplicar();
</script>
<Habla />
</body>
</html>
