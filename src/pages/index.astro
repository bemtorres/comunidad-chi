          <tr><td>hola</td><td>ho - la</td><td class="chi">chihochila</td><td><button onclick="escuchar('chihochila')">▶</button></td></tr>
          <tr><td>casa</td><td>ca - sa</td><td class="chi">chicachisa</td><td><button onclick="escuchar('chicachisa')">▶</button></td></tr>
          <tr><td>gracias</td><td>gra - cias</td><td class="chi">chigrachicias</td><td><button onclick="escuchar('chigrachicias')">▶</button></td></tr>
          <tr><td>amigo</td><td>a - mi - go</td><td class="chi">chiachimichigo</td><td><button onclick="escuchar('chiachimichigo')">▶</button></td></tr>
          <tr><td>familia</td><td>fa - mi - lia</td><td class="chi">chifachimichilia</td><td><button onclick="escuchar('chifachimichilia')">▶</button></td></tr>
