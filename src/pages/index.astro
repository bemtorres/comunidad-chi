<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Comunidad Chi 气 — El idioma secreto del Chi</title>
<meta name="description" content="Descubre el Chi: el juego de palabras transmitido de generación en generación. Pon chi antes de cada sílaba. Hola = chihochila. Sí = chiis, No = chion." />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&family=Outfit:wght@300;400;600;700;800&family=Noto+Serif+SC:wght@600;900&display=swap" rel="stylesheet" />
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏮</text></svg>" />
<style>
  :root{
    --rojo-oscuro:#5c0a0a;
    --rojo:#a31616;
    --rojo-brillante:#c1272d;
    --dorado:#d4af37;
    --dorado-claro:#f9e076;
    --crema:#fff8e7;
    --papel:#fdf3d8;
    --tinta:#2b1510;
    --negro:#160808;
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{
    margin:0;
    font-family:'Outfit',system-ui,sans-serif;
    background:var(--negro);
    color:var(--crema);
    overflow-x:hidden;
  }
  /* fondo patrón chino */
  .pattern-bg{
    position:fixed;inset:0;z-index:-2;
    background:
      radial-gradient(circle at 20% 20%, #7a1212 0%, transparent 40%),
      radial-gradient(circle at 80% 10%, #7a3a12 0%, transparent 35%),
      linear-gradient(180deg, #1e0808 0%, #2e0d0d 50%, #160808 100%);
  }
  .pattern-bg::after{
    content:"";position:absolute;inset:0;opacity:.08;
    background-image:
      repeating-linear-gradient(45deg, var(--dorado) 0 2px, transparent 2px 28px),
      repeating-linear-gradient(-45deg, var(--dorado) 0 2px, transparent 2px 28px);
  }
  a{color:inherit}
  /* NAV */
  nav{
    position:sticky;top:0;z-index:50;
    backdrop-filter:blur(12px);
    background:rgba(22,8,8,.85);
    border-bottom:2px solid var(--dorado);
  }
  .nav-inner{max-width:1100px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;padding:.8rem 1.2rem}
  .logo{display:flex;align-items:center;gap:.7rem;font-weight:800;letter-spacing:.02em}
  .sello{
    width:46px;height:46px;background:var(--rojo-brillante);color:var(--crema);
    display:grid;place-items:center;border-radius:8px;
    font-family:'Ma Shan Zheng','Noto Serif SC',serif;font-size:1.8rem;
    border:2px solid var(--dorado);box-shadow:0 0 0 3px var(--rojo-brillante), 0 6px 18px rgba(0,0,0,.5);
    transform:rotate(-4deg);
  }
  .nav-links{display:flex;gap:1.2rem;font-size:.95rem}
  .nav-links a{text-decoration:none;opacity:.85}
  .nav-links a:hover{color:var(--dorado-claro);opacity:1}
  @media(max-width:720px){.nav-links{display:none}}

  .wrap{max-width:1100px;margin:0 auto;padding:0 1.2rem}

  /* HERO */
  .hero{
    position:relative;text-align:center;
    padding:4rem 1.2rem 2.5rem;
    overflow:hidden;
  }
  .lanterns{display:flex;justify-content:center;gap:2.2rem;margin-bottom:1rem;font-size:2.4rem}
  .lantern{animation:colgar 3s ease-in-out infinite;display:inline-block;filter:drop-shadow(0 8px 16px rgba(0,0,0,.6))}
  .lantern:nth-child(2){animation-delay:.4s}
  .lantern:nth-child(3){animation-delay:.8s}
  .lantern:nth-child(4){animation-delay:1.2s}
  .lantern:nth-child(5){animation-delay:1.6s}
  @keyframes colgar{0%,100%{transform:translateY(0) rotate(-4deg)}50%{transform:translateY(10px) rotate(4deg)}}

  .etiqueta{
    display:inline-flex;align-items:center;gap:.6rem;
    border:1px solid var(--dorado);border-radius:999px;
    padding:.4rem 1rem;font-size:.85rem;letter-spacing:.18em;text-transform:uppercase;
    color:var(--dorado-claro);background:rgba(212,175,55,.1);
  }
  h1{
    font-family:'Ma Shan Zheng','Noto Serif SC',serif;
    font-size:clamp(3rem,8vw,5.8rem);line-height:.95;margin:1rem 0 .5rem;
    text-shadow:0 4px 0 #000, 0 0 30px rgba(212,175,55,.4);
  }
  h1 span{color:var(--dorado-claro)}
  .sub{max-width:660px;margin:0 auto;font-size:1.15rem;line-height:1.6;opacity:.92}
  .hanzi-deco{font-family:'Noto Serif SC',serif;opacity:.18;font-size:clamp(4rem,12vw,9rem);line-height:1;user-select:none}

  .hero-card{
    margin:2rem auto 0;max-width:760px;
    background:linear-gradient(180deg, var(--papel), #f5e3ac);
    color:var(--tinta);border-radius:20px;
    border:3px solid var(--dorado);
    outline:4px solid var(--rojo-brillante);
    padding:1.6rem;position:relative;
    box-shadow:0 24px 60px rgba(0,0,0,.55);
  }
  .hero-card::before,.hero-card::after{
    content:"龍";position:absolute;top:50%;transform:translateY(-50%);
    font-family:'Noto Serif SC',serif;font-size:3rem;opacity:.15;
  }
  .hero-card::before{left:.8rem}
  .hero-card::after{right:.8rem}
  .ejemplo-grande{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:1rem;margin:.8rem 0}
  .palabra{font-size:2.2rem;font-weight:800}
  .flecha{font-size:2rem;color:var(--rojo)}
  .resultado{
    font-family:'Ma Shan Zheng',serif;font-size:2.6rem;color:var(--rojo);
    background:#fff;border:2px dashed var(--rojo);border-radius:12px;padding:.2rem 1rem;
  }
  .desglose{font-size:1rem;background:#2b1510;color:var(--dorado-claro);border-radius:10px;padding:.6rem 1rem;display:inline-block}
  .btn-row{display:flex;flex-wrap:wrap;gap:.7rem;justify-content:center;margin-top:1.1rem}
  button{cursor:pointer;font-family:inherit}
  .btn{
    border:none;border-radius:999px;padding:.8rem 1.4rem;font-weight:700;font-size:1rem;
    transition:.2s;
  }
  .btn-rojo{background:var(--rojo-brillante);color:#fff;box-shadow:0 8px 20px rgba(193,39,45,.4)}
  .btn-rojo:hover{transform:translateY(-2px);background:#d92d33}
  .btn-dorado{background:var(--dorado);color:#2b1510}
  .btn-dorado:hover{transform:translateY(-2px);background:var(--dorado-claro)}
  .btn-ghost{background:transparent;color:var(--crema);border:1px solid var(--dorado)}

  /* SECCIONES */
  section{padding:3.2rem 0}
  .titulo-seccion{display:flex;align-items:center;gap:1rem;margin-bottom:1rem}
  .titulo-seccion .num{
    min-width:46px;height:46px;border-radius:50%;display:grid;place-items:center;
    background:var(--rojo-brillante);border:2px solid var(--dorado);font-weight:800;font-size:1.2rem;
  }
  h2{font-family:'Ma Shan Zheng',serif;font-size:clamp(2rem,4.5vw,3rem);margin:0;font-weight:400}
  h2 em{color:var(--dorado-claro);font-style:normal}
  p.lead{opacity:.9;line-height:1.7;max-width:760px}
  .linea-dorada{height:2px;background:linear-gradient(90deg, transparent, var(--dorado), transparent);margin:1.2rem 0 2rem}

  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:1.2rem}
  @media(max-width:820px){.grid2{grid-template-columns:1fr}}
  .card{
    background:rgba(255,248,231,.06);
    border:1px solid rgba(212,175,55,.4);
    border-radius:18px;padding:1.4rem 1.3rem;
    backdrop-filter:blur(6px);
  }
  .card.papel{background:linear-gradient(180deg,var(--papel),#f6e6b3);color:var(--tinta);border:3px solid var(--dorado)}
  .card h3{margin:.2rem 0 .6rem;font-size:1.25rem}
  .paso{display:flex;gap:.9rem;margin:.9rem 0}
  .paso-bola{min-width:38px;height:38px;border-radius:50%;background:var(--dorado);color:#2b1510;display:grid;place-items:center;font-weight:800}
  code.chicode{background:#2b1510;color:var(--dorado-claro);padding:.15rem .5rem;border-radius:6px;font-size:.95em}
  .tabla{width:100%;border-collapse:separate;border-spacing:0;overflow:hidden;border-radius:14px;margin-top:1rem;font-size:.98rem}
  .tabla th{background:var(--rojo-brillante);color:#fff;padding:.8rem;text-align:left}
  .tabla td{padding:.75rem .8rem;border-bottom:1px solid rgba(212,175,55,.25)}
  .tabla tr:nth-child(even) td{background:rgba(212,175,55,.08)}
  .tabla tr td:first-child{font-weight:700}
  .tabla .chi{color:var(--dorado-claro);font-weight:700}

  /* sagradas */
  .sagradas{display:grid;grid-template-columns:1fr 1fr;gap:1.2rem;margin-top:1.2rem}
  @media(max-width:720px){.sagradas{grid-template-columns:1fr}}
  .sagrada{
    border-radius:20px;padding:1.6rem;text-align:center;position:relative;overflow:hidden;
    border:3px solid var(--dorado);
  }
  .sagrada.si{background:radial-gradient(circle at 50% 0%, #2e7d32, #123d1f);color:#eaffea}
  .sagrada.no{background:radial-gradient(circle at 50% 0%, #7a1212, #2e0d0d);color:#ffe9e9}
  .sagrada .big{font-family:'Ma Shan Zheng',serif;font-size:3.6rem;line-height:1;margin:.4rem 0}
  .fonetica{display:inline-block;background:rgba(0,0,0,.35);border:1px solid rgba(255,255,255,.3);border-radius:999px;padding:.3rem .9rem;margin:.4rem 0}
  .tono{font-size:.95rem;opacity:.9;line-height:1.6}

  /* traductor */
  .traductor{
    background:linear-gradient(180deg, #fff8e7, #f7e7b8);
    color:var(--tinta);border-radius:22px;padding:1.6rem;
    border:4px double var(--rojo-brillante);
    box-shadow:0 20px 60px rgba(0,0,0,.5);
  }
  .trad-grid{display:grid;grid-template-columns:1fr auto 1fr;gap:1rem;align-items:stretch;margin-top:1rem}
  @media(max-width:820px){.trad-grid{grid-template-columns:1fr}}
  textarea{
    width:100%;min-height:160px;resize:vertical;
    border-radius:14px;border:2px solid #c9a227;background:#fffdf2;
    padding:1rem;font-family:inherit;font-size:1.05rem;line-height:1.5;color:var(--tinta);
  }
  textarea:focus{outline:3px solid rgba(193,39,45,.3);border-color:var(--rojo-brillante)}
  .flechas-trad{display:grid;place-items:center;font-size:2rem}
  .salida{
    border-radius:14px;border:2px solid var(--rojo-brillante);background:#fff;
    padding:1rem;min-height:160px;font-size:1.25rem;line-height:1.6;font-weight:600;color:var(--rojo);
    word-break:break-word;
  }
  .chips{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:.9rem}
  .chip{border:1px solid var(--rojo);background:#fff;border-radius:999px;padding:.35rem .8rem;font-size:.9rem;cursor:pointer}
  .chip:hover{background:var(--rojo-brillante);color:#fff}
  .meta{display:flex;flex-wrap:wrap;gap:.8rem;align-items:center;margin-top:.9rem;font-size:.9rem;opacity:.8}

  /* expresiones */
  .expr-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:1.2rem}
  @media(max-width:900px){.expr-grid{grid-template-columns:1fr 1fr}}
  @media(max-width:620px){.expr-grid{grid-template-columns:1fr}}
  .expr{background:#fffdf2;color:var(--tinta);border-radius:16px;padding:1rem 1rem 1.1rem;border-left:8px solid var(--rojo-brillante);border-top:2px solid var(--dorado);border-right:2px solid var(--dorado);border-bottom:2px solid var(--dorado)}
  .expr small{letter-spacing:.12em;text-transform:uppercase;color:#8a6d1b;font-weight:700;font-size:.72rem}
  .expr .es{font-weight:700;margin:.2rem 0}
  .expr .ch{font-family:'Ma Shan Zheng',serif;font-size:1.4rem;color:var(--rojo);word-break:break-word}
  .expr .des{font-size:.82rem;background:#2b1510;color:var(--dorado-claro);border-radius:8px;padding:.35rem .6rem;margin-top:.5rem;line-height:1.5}
  .expr .gesto{font-size:.88rem;margin-top:.4rem}
  .expr button{margin-top:.5rem;font-size:.85rem;border-radius:999px;border:1px solid var(--rojo);background:transparent;padding:.3rem .8rem}
  .expr button:hover{background:var(--rojo);color:#fff}
  .filtros{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1rem}
  .filtro{border:1px solid var(--dorado);background:transparent;color:var(--crema);border-radius:999px;padding:.4rem .9rem;font-size:.88rem;font-weight:600}
  .filtro.activo,.filtro:hover{background:var(--dorado);color:#2b1510}
  .buscador{margin-top:1rem;display:flex;gap:.6rem}
  .buscador input{flex:1;border-radius:999px;border:2px solid var(--dorado);background:#fffdf2;padding:.7rem 1.1rem;font-family:inherit;font-size:1rem;color:var(--tinta)}

  footer{border-top:2px solid var(--dorado);padding:2rem 1.2rem;text-align:center;opacity:.9;background:rgba(0,0,0,.4)}
  .drag{font-size:2rem}
</style>
</head>
<body>
<div class="pattern-bg"></div>

<nav>
  <div class="nav-inner">
    <div class="logo"><div class="sello">气</div><span>COMUNIDAD CHI • 社区</span></div>
    <div class="nav-links">
      <a href="#origen">Origen</a>
      <a href="#regla">La Regla</a>
      <a href="#sagradas">Chiis y Chion</a>
      <a href="#expresiones">Expresiones</a>
      <a href="#traductor">Traductor</a>
    </div>
  </div>
</nav>

<div class="wrap">
  <!-- HERO -->
  <header class="hero">
    <div class="lanterns"><span class="lantern">🏮</span><span class="lantern">🏮</span><span class="lantern">🏮</span><span class="lantern">🏮</span><span class="lantern">🏮</span></div>
    <div class="etiqueta">🏯 传承 · Transmitido de generación en generación 🏯</div>
    <h1>Habla en <span>Chi</span> <br/> 氣 Chihochila</h1>
    <div class="hanzi-deco">龍鳳呈祥 • 氣 • 語言</div>
    <p class="sub">
      Este es un proyecto que conocí desde pequeño, pasado de generación en generación:
      <strong>la forma secreta de hablar con <em style="color:var(--dorado-claro)">chi</em></strong>.
      Todo está en español, pero se pronuncia y se escribe poniendo un <strong>chi</strong> antes de cada sílaba.
    </p>

    <div class="hero-card">
      <div style="letter-spacing:.2em;font-size:.8rem;font-weight:800;color:#8a6d1b">✦ LA FÓRMULA MÁGICA ✦</div>
      <div class="ejemplo-grande">
        <span class="palabra">hola</span>
        <span class="flecha">➜</span>
        <span class="resultado" id="hero-result">chihochila</span>
      </div>
      <div><span class="desglose">ho - la &nbsp; ➜ &nbsp; <b>chi</b>ho + <b>chi</b>la = <b>chihochila</b></span></div>
      <div class="btn-row">
        <button class="btn btn-rojo" onclick="escuchar('chihochila')">🔊 Escuchar</button>
        <a href="#traductor"><button class="btn btn-dorado">🐉 Probar traductor</button></a>
        <a href="#regla"><button class="btn btn-ghost" style="color:#5c0a0a;border-color:#5c0a0a">Ver la regla</button></a>
      </div>
    </div>
  </header>

  <!-- ORIGEN -->
  <section id="origen">
    <div class="titulo-seccion"><div class="num">龍</div><h2>Origen: un secreto <em>de familia</em> 家族</h2></div>
    <p class="lead">No es un idioma nuevo. Es un <strong>juego oral ancestral</strong>, como el “jerigonza”, pero propio. Los mayores lo usaban para hablar delante de los niños sin que entendieran… y luego se lo enseñaban a los niños cuando crecían. Así pasó de abuelos → padres → hijos.</p>
    <div class="linea-dorada"></div>
    <div class="grid2">
      <div class="card">
        <h3>🏮 ¿Qué es hablar en Chi?</h3>
        <p style="line-height:1.7">Hablas normal en español, pero <strong>cifras cada palabra</strong> anteponiendo la sílaba <code class="chicode">chi</code> a cada sílaba original. Se escribe junto y se pronuncia corrido, con ritmo cantado, al estilo chino.</p>
        <ul style="line-height:1.9">
          <li>Todo está en <strong>español</strong>, solo cambia el sonido.</li>
          <li>Siempre es <strong>chi + sílaba</strong>, sin excepción (salvo Sí y No).</li>
          <li>Se habla <strong>rápido y con expresión</strong>, como si fuera mandarín.</li>
        </ul>
      </div>
      <div class="card papel">
        <h3>📜 Ejemplo paso a paso: “amigo”</h3>
        <div class="paso"><div class="paso-bola">1</div><div><strong>Separa en sílabas:</strong><br/><code class="chicode" style="background:#fff;color:#5c0a0a">a - mi - go</code></div></div>
        <div class="paso"><div class="paso-bola">2</div><div><strong>Pon chi delante de cada una:</strong><br/><code class="chicode" style="background:#fff;color:#5c0a0a">chia - chimi - chigo</code></div></div>
        <div class="paso"><div class="paso-bola">3</div><div><strong>Únelo todo:</strong><br/><span style="font-family:'Ma Shan Zheng',serif;font-size:1.8rem;color:var(--rojo)">chiachimichigo 🐲</span></div></div>
        <button class="btn btn-rojo" onclick="escuchar('chiachimichigo')">🔊 Escuchar “amigo”</button>
      </div>
    </div>
  </section>

  <!-- REGLA -->
  <section id="regla">
    <div class="titulo-seccion"><div class="num">武</div><h2>La regla de oro <em>黄金法则</em></h2></div>
    <p class="lead">Una sola regla lo gobierna todo: <strong>chi + cada sílaba</strong>. Si sabes separar en sílabas, ya sabes hablar Chi.</p>
    <div class="linea-dorada"></div>
    <div class="card">
      <h3>📖 Tabla mágica de transformaciones</h3>
      <div style="overflow-x:auto">
      <table class="tabla">
        <thead><tr><th>Español</th><th>Sílabas</th><th>En Chi</th><th>🔊</th></tr></thead>
        <tbody id="tabla-body">
          <tr><td>hola</td><td>ho - la</td><td class="chi">chihochila</td><td><button onclick="escuchar('chihochila')">▶</button></td></tr>
          <tr><td>casa</td><td>ca - sa</td><td class="chi">chicachisa</td><td><button onclick="escuchar('chicachisa')">▶</button></td></tr>
          <tr><td>gracias</td><td>gra - cias</td><td class="chi">chigrachicias</td><td><button onclick="escuchar('chigrachicias')">▶</button></td></tr>
          <tr><td>amigo</td><td>a - mi - go</td><td class="chi">chiachimichigo</td><td><button onclick="escuchar('chiachimichigo')">▶</button></td></tr>
          <tr><td>familia</td><td>fa - mi - lia</td><td class="chi">chifachimichilia</td><td><button onclick="escuchar('chifachimichilia')">▶</button></td></tr>
          <tr><td>mañana</td><td>ma - ña - na</td><td class="chi">chimachiñachina</td><td><button onclick="escuchar('chimachiñachina')">▶</button></td></tr>
          <tr><td>dragón</td><td>dra - gón</td><td class="chi">chidrachigón</td><td><button onclick="escuchar('chidrachigón')">▶</button></td></tr>
        </tbody>
      </table>
      </div>
      <p style="font-size:.92rem;opacity:.8">💡 Tip de maestro: las tildes se conservan. <em>dragón → chidrachigón</em>. Y todo se escribe en minúsculas, junto, sin guiones en la vida real.</p>
    </div>
  </section>

  <!-- SAGRADAS -->
  <section id="sagradas">
    <div class="titulo-seccion"><div class="num">陰</div><h2>Las dos palabras sagradas: <em>chiis y chion</em> 是與否</h2></div>
    <p class="lead">Aquí está <strong>la variante</strong>. Cuando decimos <strong>“sí”</strong> a una afirmación, no decimos <em>chisi</em> — le damos la vuelta y decimos <strong>chiis [chīís]</strong>, alargado y cantado hacia arriba. Cuando es <strong>“no”</strong>, decimos <strong>chion [chiǒn]</strong>, corto y cortante hacia abajo. ¡Son sagradas, no siguen la regla!</p>
    <div class="linea-dorada"></div>
    <div class="sagradas">
      <div class="sagrada si">
        <div style="font-size:2rem">🐼 是 ✅</div>
        <div class="big">chiis</div>
        <div class="fonetica">[ chīís ] — tono alto y alargado ⬆⬆</div>
        <p class="tono"><strong>Significa SÍ.</strong> Se dice con sonrisa, asintiendo, estirando la “i”: <em>¡chiiiiis!</em><br/>Ej: “¿Vienes?” → “¡Chiis!”</p>
        <button class="btn btn-dorado" onclick="escuchar('chiis')">🔊 Escuchar chiis</button>
      </div>
      <div class="sagrada no">
        <div style="font-size:2rem">🐯 否 ❌</div>
        <div class="big">chion</div>
        <div class="fonetica">[ chiǒn ] — tono que baja ⬇</div>
        <p class="tono"><strong>Significa NO.</strong> Se dice serio, negando con la cabeza, cortando la “on”: <em>¡chion!</em><br/>Ej: “¿Te rindes?” → “¡Chion!”</p>
        <button class="btn btn-rojo" onclick="escuchar('chion')">🔊 Escuchar chion</button>
      </div>
    </div>
    <div class="card" style="margin-top:1.2rem">
      <h3>🎭 ¡Con expresión! La clave del Chi</h3>
      <p style="line-height:1.7;margin:.4rem 0">El Chi sin expresión está muerto. Hay que hablarlo <strong>como un maestro de kung-fu en película china</strong>: gestos grandes, tonos exagerados, reverencia.</p>
      <ul style="line-height:2">
        <li>🙏 <strong>Chiis</strong> → manos juntas, reverencia, sonrisa y voz aguda y larga.</li>
        <li>👊 <strong>Chion</strong> → brazos cruzados, cara seria y voz grave y seca.</li>
        <li>🐉 <strong>Todo lo demás</strong> → ritmo cantado “chi-chi-chi”, como si hablaras mandarín de mentira.</li>
        <li>🏮 Los niños aprenden primero a decir <em>chiis / chion</em> con la cara, antes que las palabras.</li>
      </ul>
    </div>
  </section>

  <!-- EXPRESIONES -->
  <section id="expresiones">
    <div class="titulo-seccion"><div class="num">福</div><h2>Expresiones de todos los días <em>日常用語</em></h2></div>
    <p class="lead">Aquí vive el Chi de verdad: lo que se dice en la casa, en la calle, en la mesa y en el juego. Todas siguen la regla <strong>chi + cada sílaba</strong>, salvo <strong>chiis [chīís] = sí</strong> y <strong>chion [chiǒn] = no</strong>. Toca 🔊, repite con la cara y el cuerpo, ¡con expresión! 🎭</p>
    <div class="linea-dorada"></div>
    <div class="card">
      <h3>🎭 Cómo decirlas: la expresión manda</h3>
      <p style="line-height:1.7;margin:.4rem 0">No basta con pronunciar. Cada frase lleva su gesto, como en las películas chinas:</p>
      <ul style="line-height:2;margin:.4rem 0">
        <li>🙏 <strong>Saludos y gracias</strong> → manos juntas + reverencia + voz cantada.</li>
        <li>❤️ <strong>Amor y familia</strong> → mano en el corazón + sonrisa grande.</li>
        <li>👊 <strong>Chion / enojo</strong> → brazos cruzados + voz grave y seca.</li>
        <li>🎉 <strong>Fiesta / alegría</strong> → brazos arriba + voz aguda y rápida.</li>
      </ul>
    </div>
    <div class="buscador"><input id="buscar-expr" placeholder="🔍 Buscar expresión... ej: gracias, amigo, comer" /></div>
    <div class="filtros" id="filtros"></div>
    <div class="expr-grid" id="expr-grid"></div>
    <p style="opacity:.75;font-size:.9rem;margin-top:1rem">💡 <span id="conteo-expr"></span> — Todas se generan con el mismo traductor de abajo, así que lo que ves aquí es exactamente lo que el traductor produce.</p>
  </section>

  <!-- TRADUCTOR -->
  <section id="traductor">
    <div class="titulo-seccion"><div class="num">译</div><h2>Traductor Chi-Español <em>翻译器</em></h2></div>
    <p class="lead">Escribe en español y se convierte a Chi al instante. También puedes pegar Chi y decodificarlo. Incluye las sagradas <strong>chiis</strong> y <strong>chion</strong>.</p>
    <div class="linea-dorada"></div>
    <div class="traductor">
      <div style="display:flex;gap:.6rem;flex-wrap:wrap;align-items:center">
        <button class="btn btn-rojo" id="btn-es-chi" style="flex:1">Español ➜ Chi</button>
        <button class="btn" id="btn-chi-es" style="flex:1;background:#fff;border:2px solid var(--rojo)">Chi ➜ Español</button>
      </div>
      <div class="trad-grid">
        <div>
          <label style="font-weight:800;font-size:.9rem;letter-spacing:.06em">ENTRADA</label>
          <textarea id="entrada" placeholder="Ej: Hola amigo, ¿cómo estás? ¿Vienes mañana?">Hola amigo, ¿cómo estás?</textarea>
        </div>
        <div class="flechas-trad">🐲<br/>⇄</div>
        <div>
          <label style="font-weight:800;font-size:.9rem;letter-spacing:.06em">RESULTADO EN CHI</label>
          <div class="salida" id="salida">—</div>
        </div>
      </div>
      <div class="chips" id="chips">
        <button class="chip">Hola</button>
        <button class="chip">¿Cómo estás?</button>
        <button class="chip">Te quiero mucho</button>
        <button class="chip">Gracias por todo</button>
        <button class="chip">¿Vienes mañana?</button>
        <button class="chip">Sí</button>
        <button class="chip">No</button>
        <button class="chip">Bienvenidos a la familia</button>
      </div>
      <div class="btn-row" style="justify-content:flex-start">
        <button class="btn btn-rojo" id="btn-traducir">✨ Traducir</button>
        <button class="btn btn-dorado" id="btn-escuchar">🔊 Escuchar</button>
        <button class="btn" id="btn-copiar" style="background:#2b1510;color:var(--dorado-claro)">📋 Copiar</button>
        <button class="btn" id="btn-limpiar" style="background:#fff;border:1px solid #999">🧹 Limpiar</button>
      </div>
      <div class="meta"><span id="stats">0 palabras • 0 sílabas chi</span><span>•</span><span>Recuerda: sí → <b>chiis</b>, no → <b>chion</b></span></div>
    </div>
  </section>

  <section>
    <div class="titulo-seccion"><div class="num">学</div><h2>Aprende en 3 pasos <em>学习</em></h2></div>
    <div class="linea-dorada"></div>
    <div class="grid2">
      <div class="card papel"><h3>🥋 1. Domina las sílabas</h3><p>Di en voz alta separando: <em>ma-ña-na, gra-cias, fa-mi-lia</em>. Aplaude cada sílaba. Sin esto no hay Chi.</p></div>
      <div class="card papel"><h3>🏮 2. Agrega el chi cantado</h3><p>Repite agregando chi rapidito: <em>chimachiñachina, chigrachicias</em>. Hazlo con ritmo, como una canción.</p></div>
      <div class="card papel"><h3>🐲 3. Actúa como maestro</h3><p>Usa <em>chiis 🙏</em> y <em>chion 👊</em> con la cara y el cuerpo. Reta a tu familia a adivinar qué dijiste.</p></div>
      <div class="card"><h3>⚔️ Reto final</h3><p>Traduce “Nos vemos mañana, dragón” y grítalo con reverencia. Si alguien te entiende sin traductor… ya eres de la comunidad. <button class="btn btn-dorado" style="margin-top:.6rem" onclick="document.getElementById('entrada').value='Nos vemos mañana, dragón';document.getElementById('btn-traducir').click();document.getElementById('traductor').scrollIntoView({behavior:'smooth'})">Probar reto 🐉</button></p></div>
    </div>
  </section>
</div>

<footer>
  <div class="drag">🐉 🏮 🐼 🏮 🐲</div>
  <p><strong>Comunidad Chi 气</strong> — Un idioma de juego, transmitido de generación en generación. • <em>Hola = chihochila • Sí = chiis [chīís] • No = chion [chiǒn]</em></p>
  <p style="font-size:.85rem;opacity:.7">Hecho con ♥ al estilo chino. 龍年大吉 — Que el dragón te acompañe.</p>
</footer>

<script>
  // ---------- SILABEADOR ESPAÑOL SIMPLIFICADO ----------
  const VOCALES = "aeiouáéíóúüAEIOUÁÉÍÓÚÜ";
  const esVocal = (c) => VOCALES.includes(c);
  const esAcentoFuerte = (c) => "áéíóúÁÉÍÓÚ".includes(c);

  function dividirSilabas(palabra){
    if(!palabra) return [];
    const w = palabra;
    const n = w.length;
    // posiciones de vocales (núcleos)
    let idxV = [];
    for(let i=0;i<n;i++) if(esVocal(w[i])) idxV.push(i);
    if(idxV.length===0) return [w]; // sin vocal: una sílaba
    if(idxV.length===1){
      return [w];
    }
    let cortes = []; // índice donde empieza nueva sílaba
    for(let k=0;k<idxV.length-1;k++){
      const v1 = idxV[k], v2 = idxV[k+1];
      const entre = w.slice(v1+1, v2); // consonantes entre vocales
      const c = entre.length;
      if(c===0){
        // V-V: hiato, separar salvo diptongo débil? simplificamos: si ambas débiles o forman diptongo, no cortar
        const a = w[v1].toLowerCase(), b = w[v2].toLowerCase();
        const debiles = new Set(['i','u','ü']);
        const esDiptongo = (debiles.has(a) || debiles.has(b)) && !esAcentoFuerte(w[v1]) && !esAcentoFuerte(w[v2]);
        if(!esDiptongo) cortes.push(v2);
        // si diptongo, no corte
      } else if(c===1){
        cortes.push(v1+1); // V|CV
      } else if(c===2){
        const cc = entre.toLowerCase();
        const gruposInseparables = ['br','cr','dr','fr','gr','pr','tr','bl','cl','dl','fl','gl','pl','tl','ch','ll','rr','qu','gu'];
        if(gruposInseparables.includes(cc)) cortes.push(v1+1); // V|CCV
        else cortes.push(v1+2); // VC|CV
      } else if(c===3){
        cortes.push(v1+3); // en gral VC|CCV (las 2 últimas forman grupo)
        // ajuste: ... VCC|CV? usamos v1+2 si las últimas 2 no son grupo? simplificamos a v1+2? Mejor:
        // re-evaluar: últimas 2 letras
        const ult2 = entre.slice(1).toLowerCase();
        const grupos = ['br','cr','dr','fr','gr','pr','tr','bl','cl','fl','gl','pl','tr'];
        // si ult2 es grupo, corte antes de ellas, sino antes de última
        cortes[cortes.length-1] = grupos.includes(ult2) ? (v1+2) : (v1+3);
      } else {
        cortes.push(v1+c-1); // fallback
      }
    }
    // construir sílabas
    let silabas = [];
    let inicio = 0;
    for(const corte of cortes){
      if(corte>0 && corte<n) { silabas.push(w.slice(inicio, corte)); inicio = corte; }
    }
    silabas.push(w.slice(inicio));
    return silabas.filter(Boolean);
  }

  function palabraAChi(palabra){
    // conservar solo letras (incluye ñ, acentos)
    const m = palabra.match(/^([^A-Za-zÁÉÍÓÚÜÑñáéíóúü]*)([A-Za-zÁÉÍÓÚÜÑñáéíóúü]+)([^A-Za-zÁÉÍÓÚÜÑñáéíóúü]*)$/);
    if(!m) return palabra;
    const [, pre, nucleo, post] = m;
    const low = nucleo.toLowerCase();
    if(low==="sí"||low==="si") return pre + copiarMayus(nucleo,"chiis") + post;
    if(low==="no") return pre + copiarMayus(nucleo,"chion") + post;
    const silabas = dividirSilabas(nucleo);
    const trans = silabas.map(s => "chi" + s.toLowerCase()).join("");
    return pre + copiarMayus(nucleo, trans) + post;
  }

  function copiarMayus(orig, dest){
    if(!orig) return dest;
    if(orig[0]===orig[0].toUpperCase()) return dest[0].toUpperCase()+dest.slice(1);
    return dest;
  }

  function espanolAChi(texto){
    // separa preservando espacios
    return texto.split(/(\s+)/).map(chunk=>{
      if(/^\s+$/.test(chunk)) return chunk;
      // separar por palabras manteniendo puntuación: usamos split por límites
      return chunk.split(/([A-Za-zÁÉÍÓÚÜÑñáéíóúü]+)/g).map(p=>{
        if(/^[A-Za-zÁÉÍÓÚÜÑñáéíóúü]+$/.test(p)) return palabraAChi(p);
        return p;
      }).join("");
    }).join("");
  }

  function chiAEspanol(texto){
    return texto.split(/(\s+)/).map(chunk=>{
      if(/^\s+$/.test(chunk)) return chunk;
      return chunk.split(/([A-Za-zÁÉÍÓÚÜÑñáéíóúü]+)/g).map(p=>{
        if(!/^[A-Za-zÁÉÍÓÚÜÑñáéíóúü]+$/.test(p)) return p;
        const low = p.toLowerCase();
        if(low==="chiis") return copiarMayus(p,"sí");
        if(low==="chion") return copiarMayus(p,"no");
        // decodificar: quitar "chi" inicial de cada sílaba estimada.
        // Estrategia: separar por "chi" insensible a mayúsculas
        // Ej: chihochila -> ["","ho","la"] -> hola
        let partes = low.split("chi").filter(x=>x!=="");
        if(partes.length===0) return p;
        // Si la palabra no empezaba con chi, no era chi -> devolver original
        if(!low.startsWith("chi")) return p;
        const rec = partes.join("");
        return copiarMayus(p, rec);
      }).join("");
    }).join("");
  }

  // ---------- UI ----------
  let modo = "es-chi";
  const entrada = document.getElementById("entrada");
  const salida = document.getElementById("salida");
  const stats = document.getElementById("stats");
  const btnEsChi = document.getElementById("btn-es-chi");
  const btnChiEs = document.getElementById("btn-chi-es");

  function traducir(){
    const v = entrada.value || "";
    const res = modo==="es-chi" ? espanolAChi(v) : chiAEspanol(v);
    salida.textContent = res || "—";
    const palabras = (v.trim().match(/\S+/g)||[]).length;
    const silabasChi = (res.match(/chi/gi)||[]).length;
    stats.textContent = `${palabras} palabras • ${silabasChi} sílabas chi`;
  }

  document.getElementById("btn-traducir").addEventListener("click", traducir);
  entrada.addEventListener("input", traducir);
  btnEsChi.addEventListener("click", ()=>{
    modo="es-chi";
    btnEsChi.style.background="var(--rojo-brillante)"; btnEsChi.style.color="#fff";
    btnChiEs.style.background="#fff"; btnChiEs.style.color="#000";
    document.querySelector('label').textContent="ENTRADA";
    salida.previousElementSibling.textContent="RESULTADO EN CHI";
    traducir();
  });
  btnChiEs.addEventListener("click", ()=>{
    modo="chi-es";
    btnChiEs.style.background="var(--rojo-brillante)"; btnChiEs.style.color="#fff";
    btnEsChi.style.background="#fff"; btnEsChi.style.color="#000";
    traducir();
  });
  document.getElementById("btn-copiar").addEventListener("click", async ()=>{
    try{ await navigator.clipboard.writeText(salida.textContent); alert("¡Copiado! 复制成功 🐉"); }catch(e){ alert(salida.textContent); }
  });
  document.getElementById("btn-limpiar").addEventListener("click", ()=>{ entrada.value=""; traducir(); entrada.focus(); });
  document.getElementById("btn-escuchar").addEventListener("click", ()=> escuchar(salida.textContent));
  document.querySelectorAll("#chips .chip").forEach(ch=>{
    ch.addEventListener("click", ()=>{ entrada.value = ch.textContent; modo="es-chi"; traducir(); escuchar(salida.textContent); });
  });

  function escuchar(texto){
    try{
      speechSynthesis.cancel();
      const u = new SpeechSynthesisUtterance(texto);
      u.lang="es-ES"; u.rate=0.85; u.pitch=1.1;
      speechSynthesis.speak(u);
    }catch(e){ console.log(e); }
  }
  window.escuchar = escuchar;

  // expresiones de todos los días (se traducen con el mismo motor para ser 100% coherentes)
  const expresiones = [
    {cat:"Saludos 问候", es:"Hola, ¿cómo estás?", gesto:"🙏 reverencia + sonrisa"},
    {cat:"Saludos 问候", es:"Buenos días", gesto:"🙏 manos juntas"},
    {cat:"Saludos 问候", es:"Buenas noches", gesto:"🌙 voz suave + reverencia"},
    {cat:"Saludos 问候", es:"¿Qué tal?", gesto:"👋 mano arriba, cantado"},
    {cat:"Saludos 问候", es:"¿Qué haces?", gesto:"👀 curioso + cantado"},
    {cat:"Despedidas 告别", es:"Adiós, nos vemos mañana", gesto:"👋 adiós con las dos manos"},
    {cat:"Despedidas 告别", es:"Nos vemos al rato", gesto:"👋 guiño + cantado"},
    {cat:"Despedidas 告别", es:"Cuídate mucho", gesto:"❤️ mano al corazón"},
    {cat:"Cortesía 礼貌", es:"Gracias por todo", gesto:"🙏 reverencia profunda"},
    {cat:"Cortesía 礼貌", es:"Por favor", gesto:"🙏 manitas juntas + voz dulce"},
    {cat:"Cortesía 礼貌", es:"Perdón, lo siento", gesto:"🥺 manos al pecho"},
    {cat:"Cortesía 礼貌", es:"De nada", gesto:"😊 sonrisa + reverencia corta"},
    {cat:"Amor y amistad 爱", es:"Te quiero mucho", gesto:"❤️ manos en corazón"},
    {cat:"Amor y amistad 爱", es:"Eres mi mejor amigo", gesto:"🤗 abrazo grande"},
    {cat:"Amor y amistad 爱", es:"Abrazo grande", gesto:"🤗 brazos abiertos"},
    {cat:"Familia 家族", es:"Mamá, papá, los amo", gesto:"❤️ señalar al cielo + corazón"},
    {cat:"Familia 家族", es:"Bienvenidos a la familia", gesto:"🏮 brazos abiertos como dragón"},
    {cat:"Familia 家族", es:"Vamos a la casa", gesto:"🏠 manos como techo"},
    {cat:"Comida 美食", es:"Vamos a comer", gesto:"🍜 frotar la panza"},
    {cat:"Comida 美食", es:"Qué rico está esto", gesto:"😋 beso al aire + panza"},
    {cat:"Comida 美食", es:"Tengo hambre", gesto:"🍚 panza + cara de antojo"},
    {cat:"Juegos 街", es:"Vamos a jugar", gesto:"⚽ saltar + cantar rápido"},
    {cat:"Juegos 街", es:"Pásame la pelota", gesto:"⚽ manos pidiendo + gritito"},
    {cat:"Juegos 街", es:"Me toca a mí", gesto:"☝️ señalarse + voz aguda"},
    {cat:"Ánimo 加油", es:"Tú puedes, no te rindas", gesto:"💪 puño arriba. El 'no' es ¡chion! 👊"},
    {cat:"Emociones 情感", es:"Estoy feliz", gesto:"🎉 brazos arriba + risa"},
    {cat:"Emociones 情感", es:"Estoy enojado", gesto:"😠 brazos cruzados + voz grave"},
    {cat:"Emociones 情感", es:"Qué susto me diste", gesto:"😱 manos a la cara"},
    {cat:"Emociones 情感", es:"Qué divertido", gesto:"🤣 risa + palmas"},
    {cat:"Fiesta 庆祝", es:"Feliz cumpleaños", gesto:"🎂 cantar + palmas"},
    {cat:"Escuela 学校", es:"Vamos a la escuela", gesto:"🎒 mochila + marcha cantada"},
    {cat:"Sagradas 神圣", es:"Sí, con todo el corazón", gesto:"🙏 ¡chiis! [chīís] alargado ⬆ sonrisa + reverencia"},
    {cat:"Sagradas 神圣", es:"No, ni lo sueñes", gesto:"👊 ¡chion! [chiǒn] seco ⬇ brazos cruzados"},
    {cat:"Sagradas 神圣", es:"¿Vienes conmigo? ¡Sí!", gesto:"🙏 pregunta cantada + respuesta ¡chiis! ⬆"},
    {cat:"Sagradas 神圣", es:"¿Te rindes? ¡No!", gesto:"👊 pregunta grave + respuesta ¡chion! ⬇"},
    {cat:"Dragón 龙", es:"Que el dragón te acompañe", gesto:"🐉 brazos de dragón + voz de maestro"},
  ];

  const grid = document.getElementById("expr-grid");
  const filtrosBox = document.getElementById("filtros");
  const buscarInput = document.getElementById("buscar-expr");
  const conteo = document.getElementById("conteo-expr");
  let filtroActual = "Todas";
  const categorias = ["Todas", ...new Set(expresiones.map(e=>e.cat))];

  function desgloseChi(es){
    // muestra palabra por palabra: original → chi (para aprender)
    return es.split(/(\s+)/).map(chunk=>{
      if(/^\s+$/.test(chunk)) return " ";
      const limpio = chunk.replace(/[^A-Za-zÁÉÍÓÚÜÑñáéíóúü]/g,"");
      if(!limpio) return chunk;
      const chi = espanolAChi(limpio);
      if(limpio.toLowerCase()===chi.toLowerCase()) return chunk;
      return `${limpio}→${chi}`;
    }).join(" ");
  }

  function pintarFiltros(){
    filtrosBox.innerHTML="";
    categorias.forEach(c=>{
      const b=document.createElement("button");
      b.className="filtro"+(c===filtroActual?" activo":"");
      b.textContent=c;
      b.addEventListener("click",()=>{filtroActual=c;pintarFiltros();pintarExpr();});
      filtrosBox.appendChild(b);
    });
  }

  function pintarExpr(){
    const q=(buscarInput.value||"").toLowerCase().trim();
    grid.innerHTML="";
    let n=0;
    expresiones.forEach(e=>{
      if(filtroActual!=="Todas" && e.cat!==filtroActual) return;
      const chi = espanolAChi(e.es);
      if(q && !(e.es.toLowerCase().includes(q)||chi.toLowerCase().includes(q))) return;
      n++;
      const div = document.createElement("div");
      div.className="expr";
      const des = desgloseChi(e.es);
      div.innerHTML = `<small>${e.cat}</small><div class="es">${e.es}</div><div class="ch">${chi}</div><div class="des">🔍 ${des}</div><div class="gesto">🎭 ${e.gesto}</div><button>🔊 Escuchar</button>`;
      div.querySelector("button").addEventListener("click", ()=>escuchar(chi));
      grid.appendChild(div);
    });
    conteo.textContent = `${n} expresiones en Chi`;
    if(n===0) grid.innerHTML = `<p style="opacity:.8">😅 Chion... no encontramos nada. Prueba con “hola” o “gracias”.</p>`;
  }
  buscarInput.addEventListener("input", pintarExpr);
  pintarFiltros(); pintarExpr();

  traducir();
</script>
</body>
