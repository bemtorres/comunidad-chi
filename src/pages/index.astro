</footer>

<script>
  // Motor de Chi compartido (mismo módulo que usa el servidor para renderizar)
  import { espanolAChi, chiAEspanol } from "../lib/chi";

  // ---------- UI ----------
  let modo = "es-chi";
  const entrada = document.getElementById("entrada");
  const salida = document.getElementById("salida");
  const stats = document.getElementById("stats");
  const btnEsChi = document.getElementById("btn-es-chi");
  const btnChiEs = document.getElementById("btn-chi-es");

  function traducir(){
    const v = entrada.value || "";
    const res = modo==="es-chi" ? espanolAChi(v) : chiAEspanol(v);
    salida.textContent = res || "—";
    const palabras = (v.trim().match(/\S+/g)||[]).length;
    const silabasChi = (res.match(/chi/gi)||[]).length;
    stats.textContent = `${palabras} palabras • ${silabasChi} sílabas chi`;
  }

  document.getElementById("btn-traducir").addEventListener("click", traducir);
  entrada.addEventListener("input", traducir);
  btnEsChi.addEventListener("click", ()=>{
    modo="es-chi";
    btnEsChi.style.background="var(--rojo-brillante)"; btnEsChi.style.color="#fff";
    btnChiEs.style.background="#fff"; btnChiEs.style.color="#000";
    document.querySelector('label').textContent="ENTRADA";
    salida.previousElementSibling.textContent="RESULTADO EN CHI";
    traducir();
  });
  btnChiEs.addEventListener("click", ()=>{
    modo="chi-es";
    btnChiEs.style.background="var(--rojo-brillante)"; btnChiEs.style.color="#fff";
    btnEsChi.style.background="#fff"; btnEsChi.style.color="#000";
    traducir();
  });
  document.getElementById("btn-copiar").addEventListener("click", async ()=>{
    try{ await navigator.clipboard.writeText(salida.textContent); alert("¡Copiado! 复制成功 🐉"); }catch(e){ alert(salida.textContent); }
  });
  document.getElementById("btn-limpiar").addEventListener("click", ()=>{ entrada.value=""; traducir(); entrada.focus(); });
  document.getElementById("btn-escuchar").addEventListener("click", ()=> escuchar(salida.textContent));
  document.querySelectorAll("#chips .chip").forEach(ch=>{
    ch.addEventListener("click", ()=>{ entrada.value = ch.textContent; modo="es-chi"; traducir(); escuchar(salida.textContent); });
  });

  // La voz la maneja el modal 🎙️ (personaje, velocidad y tono)
  function escuchar(texto){
    if (window.hablar) window.hablar(texto);
  }

  // ---------- FILTROS Y ESCUCHA DE EXPRESIONES ----------
  // Las tarjetas ya vienen renderizadas desde el servidor (con estilos).
  // Aquí solo filtramos, buscamos y escuchamos.
  const grid = document.getElementById("expr-grid");
  const filtrosBox = document.getElementById("filtros");
  const buscarInput = document.getElementById("buscar-expr");
  const conteo = document.getElementById("conteo-expr");
  const vacio = document.getElementById("expr-vacio");
  const tarjetas = grid ? Array.from(grid.querySelectorAll(".expr")) : [];
  let filtroActual = "Todas";

  function filtrar(){
    const q = (buscarInput?.value || "").toLowerCase().trim();
    let n = 0;
    tarjetas.forEach((c) => {
      const cat = c.getAttribute("data-cat") || "";
      const txt = c.getAttribute("data-busca") || "";
      const ok = (filtroActual === "Todas" || cat === filtroActual) && (!q || txt.includes(q));
      c.style.display = ok ? "" : "none";
      if (ok) n++;
    });
    if (vacio) vacio.hidden = n > 0;
    if (conteo) conteo.textContent = `${n} expresiones en Chi`;
  }

  filtrosBox?.addEventListener("click", (ev) => {
    const b = (ev.target as HTMLElement | null)?.closest(".filtro") as HTMLElement | null;
    if (!b) return;
    filtroActual = b.getAttribute("data-cat") || "Todas";
    filtrosBox.querySelectorAll(".filtro").forEach((x) => x.classList.toggle("activo", x === b));
    filtrar();
  });

  buscarInput?.addEventListener("input", filtrar);

  grid?.addEventListener("click", (ev) => {
    const b = (ev.target as HTMLElement | null)?.closest("button.say") as HTMLElement | null;
    if (b) escuchar(b.getAttribute("data-tx") || "");
  });

  filtrar();

  traducir();
</script>
<Habla />
</body>
</html>
