---
import { espanolAChi, desgloseChi } from "../lib/chi";
import Habla from "../components/HablaModal.astro";
import SEO from "../components/SEO.astro";

const base = import.meta.env.BASE_URL;

type Expr = { cat: string; es: string; gesto: string };

const baseExprs: Expr[] = [
  { cat: "Saludos 问候", es: "Hola, ¿cómo estás?", gesto: "🙏 reverencia + sonrisa" },
  { cat: "Saludos 问候", es: "Buenos días", gesto: "🙏 manos juntas" },
  { cat: "Saludos 问候", es: "Buenas noches", gesto: "🌙 voz suave + reverencia" },
  { cat: "Saludos 问候", es: "¿Qué tal?", gesto: "👋 mano arriba, cantado" },
  { cat: "Saludos 问候", es: "¿Qué haces?", gesto: "👀 curioso + cantado" },
  { cat: "Despedidas 告别", es: "Adiós, nos vemos mañana", gesto: "👋 adiós con las dos manos" },
  { cat: "Despedidas 告别", es: "Nos vemos al rato", gesto: "👋 guiño + cantado" },
  { cat: "Despedidas 告别", es: "Cuídate mucho", gesto: "❤️ mano al corazón" },
  { cat: "Cortesía 礼貌", es: "Gracias por todo", gesto: "🙏 reverencia profunda" },
  { cat: "Cortesía 礼貌", es: "Por favor", gesto: "🙏 manitas juntas + voz dulce" },
  { cat: "Cortesía 礼貌", es: "Perdón, lo siento", gesto: "🥺 manos al pecho" },
  { cat: "Cortesía 礼貌", es: "De nada", gesto: "😊 sonrisa + reverencia corta" },
  { cat: "Amor y amistad 爱", es: "Te quiero mucho", gesto: "❤️ manos en corazón" },
  { cat: "Amor y amistad 爱", es: "Eres mi mejor amigo", gesto: "🤗 abrazo grande" },
  { cat: "Amor y amistad 爱", es: "Abrazo grande", gesto: "🤗 brazos abiertos" },
  { cat: "Familia 家族", es: "Mamá, papá, los amo", gesto: "❤️ señalar al cielo + corazón" },
  { cat: "Familia 家族", es: "Bienvenidos a la familia", gesto: "🏮 brazos abiertos como dragón" },
  { cat: "Familia 家族", es: "Vamos a la casa", gesto: "🏠 manos como techo" },
  { cat: "Comida 美食", es: "Vamos a comer", gesto: "🍜 frotar la panza" },
  { cat: "Comida 美食", es: "Qué rico está esto", gesto: "😋 beso al aire + panza" },
  { cat: "Comida 美食", es: "Tengo hambre", gesto: "🍚 panza + cara de antojo" },
  { cat: "Juegos 街", es: "Vamos a jugar", gesto: "⚽ saltar + cantar rápido" },
  { cat: "Juegos 街", es: "Pásame la pelota", gesto: "⚽ manos pidiendo + gritito" },
  { cat: "Juegos 街", es: "Me toca a mí", gesto: "☝️ señalarse + voz aguda" },
  { cat: "Ánimo 加油", es: "Tú puedes, no te rindas", gesto: "💪 puño arriba. El 'no' es ¡chion! 👊" },
  { cat: "Emociones 情感", es: "Estoy feliz", gesto: "🎉 brazos arriba + risa" },
  { cat: "Emociones 情感", es: "Estoy enojado", gesto: "😠 brazos cruzados + voz grave" },
  { cat: "Emociones 情感", es: "Qué susto me diste", gesto: "😱 manos a la cara" },
  { cat: "Emociones 情感", es: "Qué divertido", gesto: "🤣 risa + palmas" },
  { cat: "Fiesta 庆祝", es: "Feliz cumpleaños", gesto: "🎂 cantar + palmas" },
  { cat: "Escuela 学校", es: "Vamos a la escuela", gesto: "🎒 mochila + marcha cantada" },
  { cat: "Sagradas 神圣", es: "Sí, con todo el corazón", gesto: "🙏 ¡chiis! [chīís] alargado ⬆ sonrisa + reverencia" },
  { cat: "Sagradas 神圣", es: "No, ni lo sueñes", gesto: "👊 ¡chion! [chiǒn] seco ⬇ brazos cruzados" },
  { cat: "Sagradas 神圣", es: "¿Vienes conmigo? ¡Sí!", gesto: "🙏 pregunta cantada + respuesta ¡chiis! ⬆" },
  { cat: "Sagradas 神圣", es: "¿Te rindes? ¡No!", gesto: "👊 pregunta grave + respuesta ¡chion! ⬇" },
  { cat: "Dragón 龙", es: "Que el dragón te acompañe", gesto: "🐉 brazos de dragón + voz de maestro" },
];

const expresiones = baseExprs.map((e) => ({
  ...e,
  chi: espanolAChi(e.es),
  des: desgloseChi(e.es),
}));

const categorias = ["Todas", ...new Set(expresiones.map((e) => e.cat))];

const faqs = [
  {
    q: "¿Qué es el chi y cómo se aprende?",
    a: "El chi (chihochila) es un idioma de juego en español: se antepone la sílaba chi a cada sílaba. Hola = chihochila, gracias = chigrachicias, amigo = chiachimichigo. Se aprende gratis con el curso online CHIA, CHIB y CHIC, con lecciones, frases, cuentos, diálogos y exámenes.",
  },
  {
    q: "¿El curso de chi es gratis (chi free)?",
    a: "Sí. Todo el curso de chi es 100% gratis y sin registro: lecciones, expresiones del día a día, traductor chi-español, voz para escuchar y los tres niveles CHIA, CHIB y CHIC.",
  },
  {
    q: "¿Cuánto se tarda en aprender chi?",
    a: "Con 15 minutos al día, en una semana ya te presentas en chi (nivel CHIA) y en un mes conversas sobre tu día (nivel CHIB). El nivel CHIC es para dialogar con otro sin frenarte, con trabalenguas y debate.",
  },
  {
    q: "¿Qué significan chiis y chion?",
    a: "chiis [chīís] significa SÍ y chion [chiǒn] significa NO. Son las dos palabras sagradas: no siguen la regla de chi + sílaba y se dicen con expresión — chiis con reverencia y voz larga, chion con brazos cruzados y voz seca.",
  },
  {
    q: "¿Hay traductor de chi a español?",
    a: "Sí, gratis y online. Escribe en español y obtén chi, o escribe en chi y lo traduce a español: muestra las sílabas, el desglose palabra por palabra, copia al portapapeles y lee en voz alta con distintas voces.",
  },
  {
    q: "¿Qué significa chihochila?",
    a: "Chihochila es la traducción de hola: ho - la ➜ chiho - chila. Es la primera palabra de toda conversación en chi, junto con chiis (sí) y chion (no).",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Comunidad Chi · chihochila.com",
    url: "https://www.chihochila.com/",
    inLanguage: "es",
    description:
      "Aprende chi gratis: curso online CHIA, CHIB y CHIC, traductor chi-español, expresiones y voz.",
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Comunidad Chi",
    url: "https://www.chihochila.com/",
    logo: "https://www.chihochila.com/og.png",
    slogan: "Aprende chi gratis · Curso chi free",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<!DOCTYPE html>
<html lang="es">
<head>
<SEO
  title="Aprende chi gratis · Curso online de chi | chihochila.com"
  description="Aprende chi gratis con el curso online CHIA, CHIB y CHIC: lecciones, expresiones, traductor chi-español y voz. Habla chihochila desde cero. Curso chi 100% free, sin registro."
  path="/"
  keywords="aprender chi, curso chi gratis, chi free, aprender chi online, curso de chi, idioma chi, chihochila, chiis, chion, traductor chi, aprender chihochila"
  jsonLd={jsonLd}
/>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&family=Outfit:wght@300;400;600;700;800&family=Noto+Serif+SC:wght@600;900&display=swap" rel="stylesheet" />
<style>
  :root{
    --rojo-oscuro:#5c0a0a;
    --rojo:#a31616;
    --rojo-brillante:#c1272d;
    --dorado:#d4af37;
    --dorado-claro:#f9e076;
    --crema:#fff8e7;
    --papel:#fdf3d8;
    --tinta:#2b1510;
    --negro:#160808;
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{
    margin:0;
    font-family:'Outfit',system-ui,sans-serif;
    background:var(--negro);
    color:var(--crema);
    overflow-x:hidden;
  }
  /* fondo patrón chino */
  .pattern-bg{
    position:fixed;inset:0;z-index:-2;
    background:
      radial-gradient(circle at 20% 20%, #7a1212 0%, transparent 40%),
      radial-gradient(circle at 80% 10%, #7a3a12 0%, transparent 35%),
      linear-gradient(180deg, #1e0808 0%, #2e0d0d 50%, #160808 100%);
  }
  .pattern-bg::after{
    content:"";position:absolute;inset:0;opacity:.08;
    background-image:
      repeating-linear-gradient(45deg, var(--dorado) 0 2px, transparent 2px 28px),
      repeating-linear-gradient(-45deg, var(--dorado) 0 2px, transparent 2px 28px);
  }
  a{color:inherit}
  /* NAV */
  nav{
    position:sticky;top:0;z-index:50;
    backdrop-filter:blur(12px);
    background:rgba(22,8,8,.85);
    border-bottom:2px solid var(--dorado);
  }
  .nav-inner{max-width:1100px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;padding:.8rem 1.2rem}
  .logo{display:flex;align-items:center;gap:.7rem;font-weight:800;letter-spacing:.02em}
  .sello{
    width:46px;height:46px;background:var(--rojo-brillante);color:var(--crema);
    display:grid;place-items:center;border-radius:8px;
    font-family:'Ma Shan Zheng','Noto Serif SC',serif;font-size:1.8rem;
    border:2px solid var(--dorado);box-shadow:0 0 0 3px var(--rojo-brillante), 0 6px 18px rgba(0,0,0,.5);
    transform:rotate(-4deg);
  }
  .nav-links{display:flex;gap:1.2rem;font-size:.95rem}
  .nav-links a{text-decoration:none;opacity:.85}
  .nav-links a:hover{color:var(--dorado-claro);opacity:1}
  @media(max-width:720px){.nav-links{display:none}}

  .wrap{max-width:1100px;margin:0 auto;padding:0 1.2rem}

  /* HERO */
  .hero{
    position:relative;text-align:center;
    padding:4rem 1.2rem 2.5rem;
    overflow:hidden;
  }
  .lanterns{display:flex;justify-content:center;gap:2.2rem;margin-bottom:1rem;font-size:2.4rem}
  .lantern{animation:colgar 3s ease-in-out infinite;display:inline-block;filter:drop-shadow(0 8px 16px rgba(0,0,0,.6))}
  .lantern:nth-child(2){animation-delay:.4s}
  .lantern:nth-child(3){animation-delay:.8s}
  .lantern:nth-child(4){animation-delay:1.2s}
  .lantern:nth-child(5){animation-delay:1.6s}
  @keyframes colgar{0%,100%{transform:translateY(0) rotate(-4deg)}50%{transform:translateY(10px) rotate(4deg)}}

  .etiqueta{
    display:inline-flex;align-items:center;gap:.6rem;
    border:1px solid var(--dorado);border-radius:999px;
    padding:.4rem 1rem;font-size:.85rem;letter-spacing:.18em;text-transform:uppercase;
    color:var(--dorado-claro);background:rgba(212,175,55,.1);
  }
  h1{
    font-family:'Ma Shan Zheng','Noto Serif SC',serif;
    font-size:clamp(3rem,8vw,5.8rem);line-height:.95;margin:1rem 0 .5rem;
    text-shadow:0 4px 0 #000, 0 0 30px rgba(212,175,55,.4);
  }
  h1 span{color:var(--dorado-claro)}
  .sub{max-width:660px;margin:0 auto;font-size:1.15rem;line-height:1.6;opacity:.92}
  .hanzi-deco{
    position:absolute;top:50%;left:50%;z-index:0;
    transform:translate(-50%,-50%);
    font-family:'Noto Serif SC',serif;font-size:clamp(4rem,12vw,9rem);
    line-height:1;opacity:.18;user-select:none;pointer-events:none;white-space:nowrap;
  }
  .hero>*:not(.hanzi-deco){position:relative;z-index:1}

  .hero-card{
    margin:2rem auto 0;max-width:760px;
    background:linear-gradient(180deg, var(--papel), #f5e3ac);
    color:var(--tinta);border-radius:20px;
    border:3px solid var(--dorado);
    outline:4px solid var(--rojo-brillante);
    padding:1.6rem;position:relative;
    box-shadow:0 24px 60px rgba(0,0,0,.55);
  }
  .hero-card::before,.hero-card::after{
    content:"龍";position:absolute;top:50%;transform:translateY(-50%);
    font-family:'Noto Serif SC',serif;font-size:3rem;opacity:.15;
  }
  .hero-card::before{left:.8rem}
  .hero-card::after{right:.8rem}
  .ejemplo-grande{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:1rem;margin:.8rem 0}
  .palabra{font-size:2.2rem;font-weight:800}
  .flecha{font-size:2rem;color:var(--rojo)}
  .resultado{
    font-family:'Ma Shan Zheng',serif;font-size:2.6rem;color:var(--rojo);
    background:#fff;border:2px dashed var(--rojo);border-radius:12px;padding:.2rem 1rem;
  }
  .desglose{font-size:1rem;background:#2b1510;color:var(--dorado-claro);border-radius:10px;padding:.6rem 1rem;display:inline-block}
  .btn-row{display:flex;flex-wrap:wrap;gap:.7rem;justify-content:center;margin-top:1.1rem}
  button{cursor:pointer;font-family:inherit}
  .btn{
    border:none;border-radius:999px;padding:.8rem 1.4rem;font-weight:700;font-size:1rem;
    transition:.2s;
  }
  .btn-rojo{background:var(--rojo-brillante);color:#fff;box-shadow:0 8px 20px rgba(193,39,45,.4)}
  .btn-rojo:hover{transform:translateY(-2px);background:#d92d33}
  .btn-dorado{background:var(--dorado);color:#2b1510}
  .btn-dorado:hover{transform:translateY(-2px);background:var(--dorado-claro)}
  .btn-ghost{background:transparent;color:var(--crema);border:1px solid var(--dorado)}

  /* SECCIONES */
  section{padding:3.2rem 0}
  .titulo-seccion{display:flex;align-items:center;gap:1rem;margin-bottom:1rem}
  .titulo-seccion .num{
    min-width:46px;height:46px;border-radius:50%;display:grid;place-items:center;
    background:var(--rojo-brillante);border:2px solid var(--dorado);font-weight:800;font-size:1.2rem;
  }
  h2{font-family:'Ma Shan Zheng',serif;font-size:clamp(2rem,4.5vw,3rem);margin:0;font-weight:400}
  h2 em{color:var(--dorado-claro);font-style:normal}
  p.lead{opacity:.9;line-height:1.7;max-width:760px}
  .linea-dorada{height:2px;background:linear-gradient(90deg, transparent, var(--dorado), transparent);margin:1.2rem 0 2rem}

  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:1.2rem}
  @media(max-width:820px){.grid2{grid-template-columns:1fr}}
  .card{
    background:rgba(255,248,231,.06);
    border:1px solid rgba(212,175,55,.4);
    border-radius:18px;padding:1.4rem 1.3rem;
    backdrop-filter:blur(6px);
  }
  .card.papel{background:linear-gradient(180deg,var(--papel),#f6e6b3);color:var(--tinta);border:3px solid var(--dorado)}
  .card h3{margin:.2rem 0 .6rem;font-size:1.25rem}
  details.faq{padding:0}
  details.faq summary{
    cursor:pointer;list-style:none;padding:1.15rem 1.3rem;
    font-weight:800;color:var(--dorado-claro);font-size:1.02rem;
    display:flex;justify-content:space-between;gap:.8rem;align-items:center;
  }
  details.faq summary::-webkit-details-marker{display:none}
  details.faq summary::after{content:"➕";color:var(--dorado);font-weight:800}
  details.faq[open]{background:rgba(255,248,231,.12)}
  details.faq[open] summary{border-bottom:1px solid rgba(212,175,55,.35)}
  details.faq[open] summary::after{content:"➖"}
  details.faq p{margin:.9rem 1.3rem 1.3rem;line-height:1.75;opacity:.92}
  .paso{display:flex;gap:.9rem;margin:.9rem 0}
  .paso-bola{min-width:38px;height:38px;border-radius:50%;background:var(--dorado);color:#2b1510;display:grid;place-items:center;font-weight:800}
  code.chicode{background:#2b1510;color:var(--dorado-claro);padding:.15rem .5rem;border-radius:6px;font-size:.95em}
  .tabla{width:100%;border-collapse:separate;border-spacing:0;overflow:hidden;border-radius:14px;margin-top:1rem;font-size:.98rem}
  .tabla th{background:var(--rojo-brillante);color:#fff;padding:.8rem;text-align:left}
  .tabla td{padding:.75rem .8rem;border-bottom:1px solid rgba(212,175,55,.25)}
  .tabla tr:nth-child(even) td{background:rgba(212,175,55,.08)}
  .tabla tr td:first-child{font-weight:700}
  .tabla .chi{color:var(--dorado-claro);font-weight:700}

  /* sagradas */
  .sagradas{display:grid;grid-template-columns:1fr 1fr;gap:1.2rem;margin-top:1.2rem}
  @media(max-width:720px){.sagradas{grid-template-columns:1fr}}
  .sagrada{
    border-radius:20px;padding:1.6rem;text-align:center;position:relative;overflow:hidden;
    border:3px solid var(--dorado);
  }
  .sagrada.si{background:radial-gradient(circle at 50% 0%, #2e7d32, #123d1f);color:#eaffea}
  .sagrada.no{background:radial-gradient(circle at 50% 0%, #7a1212, #2e0d0d);color:#ffe9e9}
  .sagrada .big{font-family:'Ma Shan Zheng',serif;font-size:3.6rem;line-height:1;margin:.4rem 0}
  .fonetica{display:inline-block;background:rgba(0,0,0,.35);border:1px solid rgba(255,255,255,.3);border-radius:999px;padding:.3rem .9rem;margin:.4rem 0}
  .tono{font-size:.95rem;opacity:.9;line-height:1.6}

  /* traductor */
  .traductor{
    background:linear-gradient(180deg, #fff8e7, #f7e7b8);
    color:var(--tinta);border-radius:22px;padding:1.6rem;
    border:4px double var(--rojo-brillante);
    box-shadow:0 20px 60px rgba(0,0,0,.5);
  }
  .trad-grid{display:grid;grid-template-columns:1fr auto 1fr;gap:1rem;align-items:stretch;margin-top:1rem}
  @media(max-width:820px){.trad-grid{grid-template-columns:1fr}}
  textarea{
    width:100%;min-height:160px;resize:vertical;
    border-radius:14px;border:2px solid #c9a227;background:#fffdf2;
    padding:1rem;font-family:inherit;font-size:1.05rem;line-height:1.5;color:var(--tinta);
  }
  textarea:focus{outline:3px solid rgba(193,39,45,.3);border-color:var(--rojo-brillante)}
  .flechas-trad{display:grid;place-items:center;font-size:2rem}
  .salida{
    border-radius:14px;border:2px solid var(--rojo-brillante);background:#fff;
    padding:1rem;min-height:160px;font-size:1.25rem;line-height:1.6;font-weight:600;color:var(--rojo);
    word-break:break-word;
  }
  .chips{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:.9rem}
  .chip{border:1px solid var(--rojo);background:#fff;border-radius:999px;padding:.35rem .8rem;font-size:.9rem;cursor:pointer}
  .chip:hover{background:var(--rojo-brillante);color:#fff}
  .meta{display:flex;flex-wrap:wrap;gap:.8rem;align-items:center;margin-top:.9rem;font-size:.9rem;opacity:.8}

  /* expresiones */
  .expr-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1.1rem;margin-top:1.4rem}
  .expr{
    display:flex;flex-direction:column;gap:.5rem;
    background:linear-gradient(180deg,#fffdf2 0%,#fdf3d8 100%);
    color:var(--tinta);
    border-radius:18px;padding:1.1rem 1.1rem 1.2rem;
    border:2px solid var(--dorado);
    border-top:6px solid var(--rojo-brillante);
    box-shadow:0 10px 26px rgba(0,0,0,.35);
    transition:transform .18s ease, box-shadow .18s ease;
  }
  .expr:hover{transform:translateY(-5px);box-shadow:0 18px 36px rgba(0,0,0,.45)}
  .expr .cat{
    align-self:flex-start;background:var(--rojo-brillante);color:#fff;
    border-radius:999px;padding:.22rem .75rem;
    font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;font-weight:800;
  }
  .expr .es{font-weight:800;font-size:1.05rem;line-height:1.35}
  .expr .ch{
    font-family:'Ma Shan Zheng','Noto Serif SC',serif;
    font-size:1.75rem;line-height:1.15;color:var(--rojo);
    word-break:break-word;background:#fff;border:2px dashed var(--rojo);
    border-radius:12px;padding:.35rem .6rem;
  }
  .expr .des{
    font-size:.78rem;background:#2b1510;color:var(--dorado-claro);
    border-radius:10px;padding:.45rem .6rem;line-height:1.55;word-break:break-word;
  }
  .expr .gesto{
    font-size:.85rem;color:#5c0a0a;font-weight:600;
    background:rgba(193,39,45,.1);border:1px dashed var(--rojo);
    border-radius:10px;padding:.45rem .6rem;line-height:1.5;
  }
  .expr .say{
    margin-top:auto;align-self:flex-start;
    border:1px solid var(--rojo);background:transparent;color:var(--rojo);
    border-radius:999px;padding:.35rem .9rem;font-size:.85rem;font-weight:700;cursor:pointer;
    transition:.18s;
  }
  .expr .say:hover{background:var(--rojo);color:#fff}
  .expr-grid .vacio{grid-column:1/-1;background:rgba(255,248,231,.08);border:1px dashed var(--dorado);border-radius:14px;padding:1.2rem;text-align:center;opacity:.85}
